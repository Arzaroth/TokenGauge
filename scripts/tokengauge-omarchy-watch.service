[Unit]
Description=Check upstream Omarchy for changes to the TokenGauge bar widget's surface
Documentation=https://github.com/Arzaroth/TokenGauge

[Service]
Type=oneshot
# The user manager's PATH omits ~/.local/bin, where the script and
# omarchy-notification-send live.
Environment=PATH=%h/.local/bin:/usr/share/omarchy/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tokengauge-omarchy-watch --quiet
