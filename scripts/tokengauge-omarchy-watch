#!/usr/bin/env bash
# Report upstream Omarchy changes that could break the TokenGauge bar widget.
#
# The widget is a third-party plugin loaded into omarchy-shell, so it depends on
# internals with no stability promise: the components it imports from qs.Ui and
# qs.Commons, the manifest schema the plugin registry enforces, and the
# shell.json storage rules. Omarchy is pre-1.0 on that surface and those files
# move. This walks the upstream repository since the last run and reports only
# commits touching the paths we actually depend on.
#
# It never modifies anything. A hit means "read the diff", not "you are broken".
set -euo pipefail

REPO="${OMARCHY_REPO:-basecamp/omarchy}"
API="https://api.github.com/repos/$REPO"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tokengauge"
STATE_FILE="$STATE_DIR/omarchy-upstream.sha"
NOTIFY=1
QUIET=0

# Every path the widget's correctness rests on. Keep this list honest: a path
# that is not here is a path whose breakage we find out about from a user.
WATCHED=(
  "shell/services/PluginRegistry.qml" # manifest schema + entry-point loading
  "shell/Ui/"                         # Panel, KeyboardPanel, WidgetButton, ...
  "shell/Commons/Style.qml"           # spacing, font, and bar tokens
  "shell/Commons/Color.qml"           # theme palette
  "shell/plugins/agents/"             # their equivalent widget, for parity
  "config/omarchy/shell.json"         # default layout + storage rules
)
# Deliberately not watched:
#   migrations/  - upstream lands one with nearly every change, so it fired on
#                  46 of 61 commits in a trial month. A monitor that always
#                  fires is a monitor you stop reading, and a migration that
#                  actually affects us arrives with a shell.json change anyway.
#   bin/omarchy-agent-usage-*  - the usage-record contract. We render from
#                  `tokengauge-waybar --json`, not from their records, so it is
#                  not a surface we depend on. Add it if that ever changes.

usage() {
  cat <<'USAGE'
Usage: tokengauge-omarchy-watch [--no-notify] [--quiet] [--reset]

  --no-notify  Print only; do not send a desktop notification.
  --quiet      Print nothing when there is nothing to report.
  --reset      Forget the recorded commit and re-baseline on the current HEAD.

State lives in $XDG_STATE_HOME/tokengauge/omarchy-upstream.sha. The first run
records the current upstream HEAD and reports nothing, because "everything since
the beginning of the repository" is not a useful answer.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --no-notify) NOTIFY=0 ;;
  --quiet) QUIET=1 ;;
  --reset) rm -f "$STATE_FILE" ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "tokengauge-omarchy-watch: unknown option: $1" >&2
    exit 1
    ;;
  esac
  shift
done

command -v curl >/dev/null 2>&1 || { echo "tokengauge-omarchy-watch: curl not found" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "tokengauge-omarchy-watch: jq not found" >&2; exit 1; }

notify() {
  local title="$1" body="$2"
  ((NOTIFY)) || return 0
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g 󰚰 "$title" "$body" || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=tokengauge "$title" "$body" || true
  fi
}

api() {
  # Unauthenticated is fine for a public repo at this cadence, but reuse a token
  # when one is around so a shared IP's rate limit is not our problem.
  local url="$1" auth=()
  local token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
  [[ -n $token ]] && auth=(-H "Authorization: Bearer $token")
  curl -fsSL --max-time 30 "${auth[@]}" -H "Accept: application/vnd.github+json" "$url"
}

head_sha=$(api "$API/commits/HEAD" | jq -r '.sha') || {
  echo "tokengauge-omarchy-watch: could not reach $REPO" >&2
  exit 1
}
[[ -n $head_sha && $head_sha != "null" ]] || { echo "tokengauge-omarchy-watch: no HEAD sha" >&2; exit 1; }

mkdir -p "$STATE_DIR"

if [[ ! -f $STATE_FILE ]]; then
  printf '%s\n' "$head_sha" >"$STATE_FILE"
  ((QUIET)) || echo "Baselined on ${head_sha:0:12}. Nothing to compare against yet."
  exit 0
fi

last_sha=$(<"$STATE_FILE")
last_sha=${last_sha//[[:space:]]/}

if [[ $last_sha == "$head_sha" ]]; then
  ((QUIET)) || echo "No new upstream commits since ${last_sha:0:12}."
  exit 0
fi

# The compare endpoint would be one request, but it caps `files` at 300 and
# says nothing about having done so - a busy month upstream would silently hide
# watched changes behind unwatched ones. Asking per path costs one request each
# and cannot truncate.
since=$(api "$API/commits/$last_sha" | jq -r '.commit.committer.date // empty') || since=""
if [[ -z $since ]]; then
  # A force-push or a pruned commit makes the old sha unresolvable; re-baseline
  # rather than failing forever on every run from here on.
  echo "tokengauge-omarchy-watch: cannot resolve ${last_sha:0:12}; re-baselining" >&2
  printf '%s\n' "$head_sha" >"$STATE_FILE"
  exit 0
fi

report=""
total=0
for path in "${WATCHED[@]}"; do
  commits=$(api "$API/commits?path=$path&since=$since&per_page=100") || continue
  # `since` is inclusive of the boundary commit itself, which we have seen.
  n=$(jq -r --arg last "$last_sha" '[.[]? | select(.sha != $last)] | length' <<<"$commits")
  ((n == 0)) && continue
  total=$((total + n))
  newest=$(jq -r --arg last "$last_sha" '
    [.[]? | select(.sha != $last)][0]
    | "\(.sha[0:8])  \(.commit.message | split("\n")[0])"
  ' <<<"$commits")
  report+="$path  ($n commit(s))"$'\n'"    $newest"$'\n'
done

if [[ -z $report ]]; then
  printf '%s\n' "$head_sha" >"$STATE_FILE"
  ((QUIET)) || echo "No upstream commits touching the widget's surface since ${last_sha:0:12}."
  exit 0
fi

paths=$(grep -c "commit(s))$" <<<"$report" || true)
echo "$total upstream commit(s) across $paths watched path(s):"
echo
printf '%s' "$report"
echo
echo "Compare: https://github.com/$REPO/compare/${last_sha:0:12}...${head_sha:0:12}"
echo
echo "Re-run scripts/install-omarchy.sh after reviewing, and check the panel still"
echo "renders - QML errors surface in the shell log, not on screen."

notify "Omarchy upstream moved" \
  "$total commit(s) touched $paths path(s) TokenGauge's bar widget depends on. Run tokengauge-omarchy-watch for the list."

printf '%s\n' "$head_sha" >"$STATE_FILE"
