[Unit]
Description=Monthly upstream Omarchy check for the TokenGauge bar widget

[Timer]
OnCalendar=monthly
# Fire on the next boot when the machine was off at the scheduled time, rather
# than skipping the month entirely.
Persistent=true
# A monthly timer would otherwise fire at 00:00 on the 1st on every machine at
# once; nothing here is time-critical.
RandomizedDelaySec=6h

[Install]
WantedBy=timers.target
